
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=null
MQTT_PASSWORD=null
MQTT_TLS=false
MQTT_TOPIC_PREFIX=absensidikjari
MQTT_CLIENT_ID=absensidikjari-server
MQTT_QOS=1
MQTT_KEEP_ALIVE=30

# Layanan wajah Python. Bila dijalankan di komputer lain, ganti 127.0.0.1
# dengan IP komputer itu, lalu jalankan "php artisan config:clear". Port di
# sini wajib sama dengan PORT di face_service.py.
FACE_SERVICE_URL=http://127.0.0.1:5005

# Batas jarak wajah dianggap sama (kecil = ketat), nama model, batas tunggu,
# dan id perangkat kamera wajah pada riwayat presensi. Batas tunggu dibuat
# longgar karena satu foto bisa butuh belasan detik di mesin tanpa kartu grafis.
FACE_TOLERANCE=0.6
FACE_MODEL=dlib-resnet-v1
FACE_SERVICE_TIMEOUT=90
FACE_DEVICE_ID=kamera-wajah

APP_NAME="Tekara AbsenMu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
